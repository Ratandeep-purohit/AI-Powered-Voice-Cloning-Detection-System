# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql://voice_user:voice_password@localhost:5432/voice_cloning_db
TEST_DATABASE_URL=postgresql://voice_user:voice_password@localhost:5432/voice_cloning_test

# JWT Authentication — Phase 02
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Audio Intake — Phase 03
AUDIO_STORAGE_PATH=storage/audio
AUDIO_MAX_UPLOAD_SIZE_MB=25
AUDIO_ALLOWED_EXTENSIONS=wav,mp3,ogg,flac,m4a

# ASVspoof 2019 LA Dataset — Phase 05
# Keep the dataset outside the repository. Set this to the local dataset root.
ASVSPOOF_DATASET_ROOT=E:\DataSet\LA
